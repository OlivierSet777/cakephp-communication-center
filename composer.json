{
  "name": "circular-labs/communication-center",
  "description": "A reusable mobile-first communication hub for CakePHP applications.",
  "type": "cakephp-plugin",
  "license": "MIT",
  "authors": [
    {
      "name": "Circular Labs"
    }
  ],
  "require": {
    "php": ">=8.1",
    "cakephp/cakephp": "^5.0"
  },
  "require-dev": {
    "cakephp/cakephp-codesniffer": "^5.0",
    "cakephp/migrations": "^5.2",
    "phpunit/phpunit": "^10.5 || ^11.0"
  },
  "autoload": {
    "psr-4": {
      "CommunicationCenter\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "CommunicationCenter\\Test\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit -c phpunit.xml.dist",
    "cs-check": "phpcs --standard=CakePHP src tests",
    "cs-fix": "phpcbf --standard=CakePHP src tests"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "cakephp/plugin-installer": true,
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
